; NORMATIVE for v1 — wayfinder ticket 05, resolved 2026-08-22; all
; reaction points ratified (verdicts in the ticket's Answer).
;
; RUNNER <-> PLUGIN WIRE — the process protocol (design.md §6, ADR 0004).
; Encoding decision embodied here (reaction point R1): the stdio wire is
; **DAG-JSON** (the IPLD spec's JSON representation: links as {"/": "bafy…"},
; bytes as {"/": {"bytes": "<base64>"}}) — same data model as the store's
; DAG-CBOR, lossless both ways, but a shell-script plugin (the `command`
; adapter, test fakes) can produce and consume it with jq. Store documents
; stay DAG-CBOR; nothing on the wire is ever hashed as-is.
;
; CDDL below describes the *data model* level; `link` on the wire is the
; DAG-JSON link form.

link = tstr                  ; "bafy…" inside {"/": …} at the JSON layer
value = tstr / int / bool / null / link / [*value] / {*tstr => value}

; ---- stdin -> plugin: request ----------------------------------------------

request = {
  schema: 1,
  node: {
    name: tstr,              ; informational; NEVER part of any hash
    config: {*tstr => value}
  },
  inputs: {*tstr => input},  ; consumed kind -> input (mirrors derivation
                             ; keying; reaction point R6 — the illustrative
                             ; asset had a list)
  workspace: {
    dir: tstr,               ; isolated, runner-owned
    path: [*tstr]            ; constructed from consumed tool claims
  },
  ? prior: outcome-ref       ; effectful re-runs only (design.md §8)
}

input = {
  cid: link,                 ; the claim's address
  claim: {*tstr => value},
  ? annotations: {*tstr => value},   ; effectful plugins only (design.md §5)
  ? resolved: {value: tstr}  ; runner-injected secret plaintext (ADR 0005);
}                            ; effectful plugins only, never on disk

outcome-ref = {
  cid: link,
  claim: {*tstr => value},
  ? annotations: {*tstr => value}
}

; ---- stdout <- plugin, exit 0: outcome -------------------------------------

outcome = {
  schema: 1,
  claim: {*tstr => value},   ; must validate as a store `claim` whose kind
                             ; equals the node's resolved produced kind
  ? annotations: {*tstr => value}
}
; An annotation entry carrying secret material marks itself:
;   { value: …, secret: true }  — never printed, index owner-only (§9)

; ---- stdout <- plugin, exit != 0: structured error (audit log only) --------

error = {
  schema: 1,
  error: {
    message: tstr,
    ? detail: tstr,
    ? retryable: bool        ; hint only; freckles never auto-retries
  }
}
