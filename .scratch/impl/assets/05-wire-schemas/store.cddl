; PROTOTYPE — wayfinder ticket 05 (Normative wire schemas). Draft-normative:
; becomes normative when the ticket resolves; field names final unless a
; reaction point overturns them.
;
; STORE DOCUMENTS — everything here is spec-strict DAG-CBOR (design.md §7,
; ADR 0003): string-keyed maps, lists, strings, 64-bit ints, bools, null,
; CID links; NO floats. `link` below is a CBOR tag-42 CID (CIDv1, sha2-256;
; dag-cbor 0x71 for documents, raw 0x55 for blobs).
;
; Every store document carries `schema` (envelope version, hashed — no
; address stability across versions, design.md §4).

link = #6.42(bytes)          ; CIDv1 link
value = tstr / int / bool / null / link / [*value] / {*tstr => value}
                             ; the claim value model — deliberately no floats

; ---- claim (design.md §4) --------------------------------------------------
; The hashed half of an outcome. Its CID is the outcome's address (ADR 0001).
; `schema` and `kind` are the only reserved top-level fields; payload fields
; sit flat beside them, their meaning per-kind convention (design.md §4).

claim = {
  schema: 1,
  kind: tstr,                ; mandatory; flat names = official vocabulary
  *tstr => value             ; payload — per-kind convention, e.g.
}                            ;   tool: {tool, version, platform}
                             ;   file-tree: {content: link}   ; -> tree
                             ;   values: {key, content: link}

; ---- secret claim shapes (design.md §9) ------------------------------------
; The secret kind is a contract admitting shapes; `shape` is the explicit
; discriminator (open set — future shapes add values, never new kinds).

secret-claim = secret-value-claim / secret-reference-claim

secret-value-claim = {       ; identity = the ciphertext (hash-referenced);
  schema: 1,                 ; the detached (`store: false`) variant has the
  kind: "secret",            ; SAME claim — the bytes just never enter the CAS
  shape: "value",
  name: tstr,
  ciphertext: link           ; raw blob CID (sops output)
}

secret-reference-claim = {   ; identity = the logical name ALONE; provider
  schema: 1,                 ; binding is machine-local annotation state.
  kind: "secret",            ; v1: expressible, but the runner fails cleanly —
  shape: "reference",        ; "no resolver for reference-bearing secrets"
  name: tstr
}

; ---- tree document (design.md §7) ------------------------------------------
; A file tree's identity: (path -> blob CID) pairs. Deliberately NOT UnixFS.

tree = {
  schema: 1,
  entries: {*tstr => tree-entry}      ; key = relative path, sorted by codec
}
tree-entry = {
  content: link,             ; raw blob (<=1 MiB) or nested list-of-blocks doc
  ? exec: bool               ; default false; the only mode bit carried
}

; ---- derivation (design.md §8) ---------------------------------------------
; THE canonical bytes behind the derivation hash: the derivation document's
; CID *is* the derivation hash. Node names excluded by design. One claim per
; consumed kind (aggregator door shut — a future multi-consume shape would
; widen the value to a list, design.md §5).

derivation = {
  schema: 1,
  plugin: plugin-id,
  config: {*tstr => value},  ; the node config, verbatim
  inputs: {*tstr => link}    ; consumed kind -> input claim CID
}
plugin-id = link             ; the plugin claim's CID
          / builtin-id       ; built-ins: freckles' own version enters
builtin-id = {               ; provenance instead (ADR 0004)
  builtin: tstr,             ; e.g. "import-values"
  freckles: tstr             ; e.g. "0.1.0"
}

; ---- provenance record (design.md §8) --------------------------------------
; Pure links: the derivation document and the claim it produced both live in
; the store; re-recording the same derivation dedups to the same documents.

provenance = {
  schema: 1,
  derivation: link,          ; -> derivation document
  outcome: link              ; -> claim
}

; ---- resolution document (design.md §7) ------------------------------------
; Snapshot of one resolved run; replaces the lockfile. Unchanged inputs
; re-resolve to the same CID. Edges are post-inference and speak node names;
; claim CIDs live in refs and the derivation index, not here (resolution
; precedes running).

resolution = {
  schema: 1,
  config-snapshot: link,     ; tree document of the configuration working copy
  nodes: {*tstr => resolved-node}     ; key = node name
}
resolved-node = {
  plugin: plugin-id,         ; pinned (claim CID, or builtin + version)
  produces: tstr,            ; the node's produced kind, fixed at resolution
  config: {*tstr => value},
  consumes: {*tstr => tstr}  ; consumed kind -> provider node name
}
